export global Signals {
    pure public function colour(quality: Quality) -> color {
        return quality == Quality.good ? Theme.good : quality == Quality.weak ? Theme.warn : Theme.bad;
    }
}

export component Signal {
    in property <Quality> quality;
    in property <length> size: 15px;
    width: size;
    height: size;
    property <int> bars: quality == Quality.good ? 3 : quality == Quality.weak ? 2 : 1;
    for tall[index] in [0.5, 0.75, 1.0]: Rectangle {
        x: index * root.size * 0.375;
        y: root.size * (1 - tall);
        width: root.size * 0.25;
        height: root.size * tall;
        border-radius: 1px;
        background: Signals.colour(root.quality);
        opacity: index < root.bars ? 1 : 0.22;
        animate background, opacity { duration: Theme.quick; }
    }
}

export component Logo {
    in property <color> colour: Theme.accent;
    in property <length> size: 30px;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M6 12 a2.64 2.64 0 1 1 5.28 0 a2.64 2.64 0 1 1 -5.28 0 z";
        fill: root.colour;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12.92 15.85 A5.76 5.76 0 0 0 12.92 8.15 M15.77 18.42 A9.6 9.6 0 0 0 15.77 5.58";
        stroke: root.colour;
        stroke-width: root.size * 0.1;
        fill: transparent;
    }
}

export component Icon {
    in property <string> shape;
    in property <color> colour: Theme.text;
    in property <length> size: 20px;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.shape;
        stroke: root.colour;
        stroke-width: root.size / 12;
        stroke-line-cap: round;
        fill: transparent;
    }
}

export component Scroller {
    in property <string> label;
    in property <bool> sideways;
    in property <color> thumb-colour: Theme.scroll-thumb;
    in property <color> thumb-hover-colour: Theme.scroll-thumb-hover;
    out property <length> visible-height: flick.height;
    out property <length> content-height: flick.content-height;
    in-out property <length> content-y <=> flick.content-y;
    property <length> page: root.sideways ? flick.width : flick.height;
    property <length> reach: max(0px, (root.sideways ? flick.content-width : flick.content-height) - root.page);
    property <length> along: root.sideways ? -flick.content-x : -flick.content-y;
    property <length> track: root.page - 2 * Theme.space-xs;
    property <length> thumb-length: root.page + root.reach > 0 ? max(Theme.scroll-thumb-least, root.track * (root.page / (root.page + root.reach))) : 0px;
    property <length> thumb-at: Theme.space-xs + (root.reach > 0 ? (root.track - root.thumb-length) * (root.along / root.reach) : 0px);
    function go(to: length) {
        if root.sideways {
            flick.content-x = -clamp(to, 0px, root.reach);
        } else {
            flick.content-y = -clamp(to, 0px, root.reach);
        }
    }
    min-width: 50px;
    min-height: 50px;
    preferred-width: 100%;
    preferred-height: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    flick := Flickable {
        x: 0;
        y: 0;
        width: root.sideways ? root.width : root.width - Theme.scroll-gutter;
        height: root.sideways ? root.height - Theme.scroll-gutter : root.height;
        mouse-drag-pan-enabled: false;
        @children
    }

    bar := TouchArea {
        property <length> pointer: root.sideways ? self.mouse-x : self.mouse-y;
        property <length> grabbed-along;
        property <length> grabbed-at;
        x: root.sideways ? 0 : flick.width;
        y: root.sideways ? flick.height : 0;
        width: root.sideways ? root.width : Theme.scroll-gutter;
        height: root.sideways ? Theme.scroll-gutter : root.height;
        accessible-role: slider;
        accessible-label: root.label;
        accessible-value: root.reach > 0 ? Math.round(100 * root.along / root.reach) : 0;
        accessible-value-minimum: 0;
        accessible-value-maximum: 100;
        accessible-value-step: 10;
        accessible-action-set-value(text) => {
            root.go(root.reach * clamp(text.to-float() / 100, 0, 1));
        }
        accessible-action-increment => {
            root.go(root.along + root.page);
        }
        accessible-action-decrement => {
            root.go(root.along - root.page);
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.grabbed-along = root.along;
                self.grabbed-at = self.pointer;
            }
        }
        moved => {
            if self.pressed && root.track > root.thumb-length {
                root.go(self.grabbed-along + (self.pointer - self.grabbed-at) * (root.reach / (root.track - root.thumb-length)));
            }
        }
        scroll-event(event) => {
            root.go(root.along - (root.sideways ? event.delta-x : event.delta-y));
            accept
        }
        if root.reach > 0: Rectangle {
            x: root.sideways ? root.thumb-at : (parent.width - self.width) / 2;
            y: root.sideways ? (parent.height - self.height) / 2 : root.thumb-at;
            width: root.sideways ? root.thumb-length : Theme.scroll-thumb-width;
            height: root.sideways ? Theme.scroll-thumb-width : root.thumb-length;
            border-radius: Theme.scroll-thumb-width / 2;
            background: bar.has-hover || bar.pressed ? root.thumb-hover-colour : root.thumb-colour;
            animate background { duration: Theme.quick; }
        }
    }
}

export component Tip inherits Rectangle {
    in property <string> text;
    width: word.preferred-width + 2 * Theme.space-s;
    height: 26px;
    border-radius: Theme.radius-small;
    background: Theme.toast;
    word := Text {
        text: root.text;
        color: Theme.on-accent;
        font-size: Theme.small;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FocusRing inherits Rectangle {
    in property <length> round;
    in property <length> around-width;
    in property <length> around-height;
    x: -Theme.focus-ring - 1px;
    y: -Theme.focus-ring - 1px;
    width: root.around-width + 2 * (Theme.focus-ring + 1px);
    height: root.around-height + 2 * (Theme.focus-ring + 1px);
    border-radius: root.round + Theme.focus-ring + 1px;
    border-width: Theme.focus-ring;
    border-color: Theme.accent;
}

component Keys inherits FocusScope {
    out property <bool> from-keys;
    focus-on-click: false;
    focus-gained(reason) => {
        self.from-keys = reason == FocusReason.tab-navigation;
    }
}

export component Pressable inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <TextHorizontalAlignment> tip-align: center;
    in property <bool> tip-below;
    in property <bool> takes-arrows;
    out property <bool> hover: touch.has-hover && root.enabled;
    out property <bool> down: touch.pressed && root.enabled;
    out property <bool> keyed: keys.has-focus && keys.from-keys;
    callback clicked();
    callback double-clicked();
    callback arrowed(step: int);
    public function focus-here() {
        keys.focus();
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    keys := Keys {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            if root.takes-arrows && (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                root.arrowed(1);
                return accept;
            }
            if root.takes-arrows && (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                root.arrowed(-1);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }

    if root.keyed: FocusRing {
        round: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
    if root.hover && root.tip != "": Tip {
        x: root.tip-align == TextHorizontalAlignment.left ? 0 : root.tip-align == TextHorizontalAlignment.right ? root.width - self.width : (root.width - self.width) / 2;
        y: root.tip-below ? root.height + Theme.tip-gap : -self.height - Theme.tip-gap;
        text: root.tip;
    }
}

export enum Look { plain, primary, danger, quiet, stage }

export component Button inherits Pressable {
    in property <string> text;
    in property <string> shape;
    in property <Look> look: Look.plain;
    in property <bool> compact;
    property <bool> filled: root.look == Look.primary || root.look == Look.danger;
    property <color> ink: root.filled ? Theme.on-accent : root.look == Look.stage ? Theme.on-stage : Theme.text;
    label: root.text;
    height: root.compact ? Theme.control-compact : Theme.control;
    min-width: content.preferred-width + (root.compact ? 2 * Theme.space-m : 2 * Theme.space-l);
    horizontal-stretch: 0;
    border-radius: Theme.radius-small;
    background: root.look == Look.primary ? Theme.accent
        : root.look == Look.danger ? Theme.bad-fill
        : root.look == Look.quiet ? (root.hover ? Theme.raised : transparent)
        : root.look == Look.stage ? (root.hover ? Theme.stage-button-lit : Theme.stage-button)
        : (root.hover ? Theme.raised-hover : Theme.raised);
    opacity: !root.enabled ? Theme.disabled : root.down ? Theme.pressed : 1;
    animate background { duration: Theme.quick; }
    content := HorizontalLayout {
        alignment: center;
        spacing: Theme.space-s;
        if root.shape != "": VerticalLayout {
            alignment: center;
            Icon {
                shape: root.shape;
                colour: root.ink;
                size: Theme.icon-mark;
            }
        }
        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.body;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component MainButton inherits Button {
    look: Look.primary;
    height: Theme.control-large;
    min-width: 200px;
}

export component Count {
    in property <string> value;
    in property <string> shape;
    in property <string> words;
    in property <color> colour: Theme.text;
    in property <color> icon-colour: Theme.text-dim;
    in property <length> size: Theme.body;
    in property <int> weight: 600;
    accessible-role: text;
    accessible-label: root.words;
    HorizontalLayout {
        spacing: Theme.space-xs;
        alignment: end;
        Text {
            text: root.value;
            accessible-role: none;
            color: root.colour;
            font-size: root.size;
            font-weight: root.weight;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                shape: root.shape;
                colour: root.icon-colour;
                size: Theme.icon-mark;
            }
        }
    }
}

export component ToolButton inherits Pressable {
    in property <string> shape;
    in property <bool> alarming;
    in property <color> alarm: Theme.bad-fill;
    width: Theme.tool;
    height: Theme.tool;
    border-radius: Theme.radius;
    background: alarming ? alarm : root.hover ? Theme.raised-hover : transparent;
    opacity: !root.enabled ? Theme.disabled : root.down ? Theme.pressed : 1;
    animate background { duration: Theme.quick; }
    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        shape: root.shape;
        colour: root.alarming ? Theme.on-accent : Theme.text;
        size: Theme.icon-tool;
    }
}

export component IconButton inherits Pressable {
    in property <string> shape;
    in property <color> colour: Theme.text-dim;
    in property <color> plate: transparent;
    in property <color> hover-plate: Theme.raised-hover;
    in property <color> hover-colour: Theme.text;
    in property <length> size: 30px;
    width: size;
    height: size;
    border-radius: size / 2;
    background: root.hover ? root.hover-plate : plate;
    opacity: !root.enabled ? Theme.disabled : root.down ? Theme.pressed : 1;
    animate background { duration: Theme.quick; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        shape: root.shape;
        colour: root.hover ? root.hover-colour : root.colour;
        size: root.size * 0.58;
    }
}

export component Link inherits Pressable {
    in property <string> text;
    in property <color> colour: Theme.accent;
    label: root.text;
    width: word.preferred-width;
    height: Theme.control-compact;
    horizontal-stretch: 0;
    opacity: root.down ? Theme.pressed : 1;
    word := Text {
        text: root.text;
        accessible-role: none;
        color: root.colour;
        font-size: Theme.tiny;
        font-weight: 500;
        vertical-alignment: center;
    }

    Rectangle {
        y: (parent.height + word.preferred-height) / 2;
        width: word.preferred-width;
        height: 1px;
        background: root.colour;
        opacity: root.hover ? 1 : 0.45;
        animate opacity { duration: Theme.quick; }
    }
}

export component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled();
    width: 40px;
    height: 24px;
    border-radius: self.height / 2;
    background: on ? Theme.accent : Theme.raised-hover;
    opacity: enabled ? 1 : Theme.disabled;
    animate background { duration: Theme.quick; }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => {
        if root.enabled {
            root.toggled();
        }
    }
    keys := Keys {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: self.height / 2;
        background: Theme.knob;
        drop-shadow-blur: 3px;
        drop-shadow-color: Theme.knob-shadow;
        animate x {
            duration: Theme.quick;
            easing: ease-out;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled();
        }
    }

    if keys.has-focus && keys.from-keys: FocusRing {
        round: root.border-radius;
        around-width: root.width;
        around-height: root.height;
    }
}

export component SwitchLine inherits Pressable {
    in property <string> text;
    in property <bool> on;
    in property <color> ink: Theme.text;
    in property <length> font-size: Theme.body;
    callback toggled();
    label: root.text;
    min-height: Theme.control-compact;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.on;
    clicked => {
        root.toggled();
    }
    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: root.text;
            accessible-role: none;
            color: root.ink;
            font-size: root.font-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 24px;
                border-radius: self.height / 2;
                background: root.on ? Theme.accent : Theme.raised-hover;
                opacity: root.enabled ? 1 : Theme.disabled;
                animate background { duration: Theme.quick; }
                Rectangle {
                    x: root.on ? 18px : 2px;
                    y: 2px;
                    width: 20px;
                    height: 20px;
                    border-radius: self.height / 2;
                    background: Theme.knob;
                    drop-shadow-blur: 3px;
                    drop-shadow-color: Theme.knob-shadow;
                    animate x {
                        duration: Theme.quick;
                        easing: ease-out;
                    }
                }
            }
        }
    }
}

export component SliderBar inherits Rectangle {
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> value;
    in property <float> step: 1;

    in property <float> mark: minimum - 1;
    in property <bool> enabled: true;
    in property <color> fill: Theme.accent;
    in property <color> track: Theme.raised-hover;
    in property <color> mark-colour: Theme.text-faint;
    callback moved(value: float);
    callback released();
    height: Theme.control-compact;
    min-width: 80px;
    horizontal-stretch: 1;
    opacity: enabled ? 1 : Theme.disabled;
    property <length> knob: 16px;
    property <float> along: clamp((value - minimum) / (maximum - minimum), 0, 1);
    property <length> run: self.width - root.knob;
    function nudge(by: float) {
        root.moved(clamp(root.value + by, root.minimum, root.maximum));
        root.released();
    }
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(text) => {
        if root.enabled {
            root.moved(clamp(text.to-float(), root.minimum, root.maximum));
            root.released();
        }
    }
    accessible-action-increment => {
        if root.enabled {
            root.nudge(root.step);
        }
    }
    accessible-action-decrement => {
        if root.enabled {
            root.nudge(-root.step);
        }
    }
    keys := Keys {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.nudge(root.step);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.nudge(-root.step);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: root.knob / 2;
        y: (parent.height - self.height) / 2;
        width: root.run;
        height: 4px;
        border-radius: self.height / 2;
        background: root.track;
        Rectangle {
            x: 0;
            width: parent.width * root.along;
            border-radius: parent.border-radius;
            background: root.fill;
        }
    }

    if root.mark >= root.minimum && root.mark <= root.maximum: Rectangle {
        x: root.knob / 2 + root.run * (root.mark - root.minimum) / (root.maximum - root.minimum) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: 10px;
        border-radius: self.width / 2;
        background: root.mark-colour;
    }
    Rectangle {
        x: root.run * root.along;
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.width / 2;
        background: Theme.knob;
        drop-shadow-blur: 4px;
        drop-shadow-color: Theme.thumb-shadow;
        if keys.has-focus && keys.from-keys: FocusRing {
            round: root.knob / 2;
            around-width: root.knob;
            around-height: root.knob;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        property <float> wanted: root.minimum + clamp((self.mouse-x - root.knob / 2) / root.run, 0, 1) * (root.maximum - root.minimum);
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.moved(Math.round(self.wanted / root.step) * root.step);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.released();
            }
        }
        moved => {
            if self.pressed {
                root.moved(Math.round(self.wanted / root.step) * root.step);
            }
        }
    }
}

export component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <string> hint;
    in-out property <string> text <=> input.text;
    in property <bool> secret;
    in property <bool> wrong;
    in property <int> limit: 80;
    in property <length> writing: Theme.body;
    in property <int> weight: 400;
    out property <bool> focused: input.has-focus;
    callback accepted(text: string);
    callback edited(text: string);
    callback backed-out() -> bool;
    callback left();

    public function focus-here() {
        input.focus();
        input.select-all();
    }
    public function let-go() {
        input.clear-focus();
    }
    public function clear() {
        input.text = "";
    }
    height: Theme.control;
    horizontal-stretch: 1;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: root.wrong ? Theme.bad : input.has-focus ? Theme.accent : Theme.line;
    background: Theme.raised;
    animate border-color { duration: Theme.quick; }
    changed focused => {
        if !root.focused {
            root.left();
        }
    }
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.secret ? "" : input.text;
    accessible-placeholder-text: root.placeholder;
    accessible-action-set-value(text) => {
        input.text = text;
        root.keep-to-limit();
    }
    function keep-to-limit() {
        if input.text.character-count > root.limit {
            input.text = Strings.first(input.text, root.limit);
        }
        root.edited(input.text);
    }
    accessible-action-default => {
        root.accepted(input.text);
    }
    property <string> offer: input.has-focus ? root.hint : "";
    property <length> aside: root.offer == "" ? 0 : cap.width + Theme.space-m;
    if input.text == "": Text {
        x: Theme.space-m;
        width: parent.width - 2 * Theme.space-m - root.aside;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: root.writing;
        font-weight: root.weight;
        vertical-alignment: center;
        overflow: elide;
    }
    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape && root.backed-out() {
                return accept;
            }
            return reject;
        }
        input := TextInput {
            x: Theme.space-m;
            width: parent.width - 2 * Theme.space-m - root.aside;
            height: parent.height;
            vertical-alignment: center;
            single-line: true;
            color: Theme.text;
            font-size: root.writing;
            font-weight: root.weight;
            input-type: root.secret ? InputType.password : InputType.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accepted => {
                root.accepted(self.text);
            }
            edited => {
                root.keep-to-limit();
            }
        }
    }

    cap := Pressable {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: root.offer == "" ? 0 : note.preferred-width + 2 * Theme.space-s;
        height: 24px;
        label: root.offer;
        border-radius: Theme.radius-tiny;
        background: Theme.accent;
        opacity: self.down ? Theme.pressed : 1;
        clip: true;
        clicked => {
            root.accepted(input.text);
        }
        note := Text {
            width: 100%;
            height: 100%;
            text: root.hint;
            accessible-role: none;
            color: Theme.on-accent;
            font-size: Theme.tiny;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component PasswordField inherits Field {
    secret: true;
    limit: 64;
}

export component NameField inherits Field {
    label: "Your name";
    placeholder: "Your name";
    limit: 24;
    text: State.me.name;
}

export component Segmented inherits Rectangle {
    in property <string> label;
    in property <[string]> choices;
    in property <int> chosen;
    callback picked(index: int);
    height: Theme.control-small;
    horizontal-stretch: 0;
    border-radius: Theme.radius-small;
    background: Theme.raised;
    HorizontalLayout {
        padding: Theme.space-xxs;
        spacing: Theme.space-xxs;
        for choice[index] in root.choices: Pressable {
            label: root.label + ": " + choice;
            min-width: word.preferred-width + 2 * Theme.space-m;
            border-radius: Theme.radius-small - Theme.space-xxs;
            background: index == root.chosen ? Theme.accent : self.hover ? Theme.raised-hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-checkable: true;
            accessible-checked: index == root.chosen;
            clicked => {
                root.picked(index);
            }
            word := Text {
                text: choice;
                color: index == root.chosen ? Theme.on-accent : Theme.text;
                font-size: Theme.small;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Picker inherits Pressable {
    in property <[string]> choices;
    in property <int> chosen;
    callback picked(index: int);
    property <string> shown: root.chosen >= 0 && root.chosen < root.choices.length ? root.choices[root.chosen] : "";
    property <length> line: Theme.control-compact;
    height: Theme.control;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: list.is-open ? Theme.accent : Theme.line;
    background: root.hover ? Theme.raised-hover : Theme.raised;
    animate background, border-color { duration: Theme.quick; }
    accessible-role: combobox;
    accessible-value: root.shown;
    accessible-action-set-value(text) => {
        if Strings.position(root.choices, text) >= 0 {
            root.picked(Strings.position(root.choices, text));
        }
    }
    takes-arrows: true;
    arrowed(step) => {
        root.picked(clamp(root.chosen + step, 0, root.choices.length - 1));
    }
    clicked => {
        list.show();
    }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        Text {
            text: root.shown;
            accessible-role: none;
            color: Theme.text;
            font-size: Theme.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                shape: Icons.down;
                colour: Theme.text-dim;
                size: Theme.icon-small;
            }
        }
    }

    list := PopupWindow {
        x: 0;
        y: root.height + Theme.space-xs;
        width: root.width;
        height: min(root.choices.length, 6) * root.line + 2 * Theme.space-xs;
        Rectangle {
            border-radius: Theme.radius;
            background: Theme.menu;
            drop-shadow-blur: Theme.lift-blur;
            drop-shadow-offset-y: Theme.lift-offset;
            drop-shadow-color: Theme.lift-shadow;
            clip: true;
            Flickable {
                x: Theme.space-xs;
                y: Theme.space-xs;
                width: parent.width - 2 * Theme.space-xs;
                height: parent.height - 2 * Theme.space-xs;
                content-height: root.choices.length * root.line;
                content-y: -clamp(root.chosen - 5, 0, max(0, root.choices.length - 6)) * root.line;
                for choice[index] in root.choices: Pressable {
                    y: index * root.line;
                    width: parent.width;
                    height: root.line;
                    label: choice;
                    border-radius: Theme.radius-tiny;
                    background: self.hover ? Theme.menu-hover : transparent;
                    accessible-checkable: true;
                    accessible-checked: index == root.chosen;
                    clicked => {
                        root.picked(index);
                        list.close();
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-s;
                        padding-right: Theme.space-s;
                        spacing: Theme.space-s;
                        Text {
                            text: choice;
                            accessible-role: none;
                            color: Theme.text;
                            font-size: Theme.body;
                            font-weight: index == root.chosen ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                shape: Icons.check;
                                colour: Theme.accent;
                                size: Theme.icon-small;
                                opacity: index == root.chosen ? 1 : 0;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component Avatar inherits Rectangle {
    in property <Face> face;
    in property <bool> talking;
    in property <length> size: 34px;
    width: size;
    height: size;

    Rectangle {
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.talking ? Theme.good : transparent;
        animate border-color { duration: Theme.quick; }
    }

    Rectangle {
        property <bool> worn: root.face.animal != "";
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        border-radius: self.width / 2;

        background: self.worn ? Theme.raised : Avatars.colour(root.face.tint);
        Text {
            y: parent.worn ? root.size * 0.05 : 0;
            width: 100%;
            height: 100%;
            text: parent.worn ? root.face.animal : root.face.initials;
            color: Theme.on-accent;
            font-size: root.size * (parent.worn ? 0.56 : 0.34);
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component AnimalCell inherits Pressable {
    in property <string> glyph;
    in property <Face> face;
    in property <bool> chosen;
    in property <length> size: 50px;
    property <bool> worn: root.glyph != "";
    property <length> disc: root.size - 8px;
    width: size;
    height: size;
    horizontal-stretch: 0;
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: root.chosen ? Theme.accent : root.hover ? Theme.line : transparent;
    accessible-checkable: true;
    accessible-checked: root.chosen;
    animate border-color { duration: Theme.quick; }
    Rectangle {
        x: 4px;
        y: 4px;
        width: root.disc;
        height: root.disc;
        border-radius: self.width / 2;
        background: root.worn ? (root.hover ? Theme.raised-hover : Theme.raised) : Avatars.colour(root.face.tint);
        animate background { duration: Theme.quick; }
        Text {
            y: root.worn ? root.disc * 0.05 : 0;
            width: 100%;
            height: 100%;
            text: root.worn ? root.glyph : root.face.initials;
            accessible-role: none;
            color: Theme.on-accent;
            font-size: root.disc * (root.worn ? 0.56 : 0.36);
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component FacePicker inherits Rectangle {
    in property <Face> face;
    in property <int> across: 6;
    in property <length> biggest: 52px;
    property <length> step: min(root.width / root.across, root.biggest);
    property <int> rows: Math.ceil(State.animals.length / root.across);
    height: root.rows * root.step;
    for animal[index] in State.animals: AnimalCell {
        x: Math.mod(index, root.across) * root.step;
        y: Math.floor(index / root.across) * root.step;
        size: root.step;
        label: animal.label;
        glyph: animal.glyph;
        face: root.face;
        chosen: index == State.animal;
        clicked => {
            Do.pick-animal(index);
        }
    }
}

export component ProfileChip inherits Pressable {
    label: "Change your name and face";
    height: Theme.control-large;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: root.hover ? Theme.raised : transparent;
    animate background { duration: Theme.quick; }
    clicked => {
        Do.open-settings(SettingsPart.profile);
    }
    HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        VerticalLayout {
            alignment: center;
            Avatar {
                face: State.me;
                size: 30px;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: State.me.name;
                color: Theme.text;
                font-size: Theme.body;
                font-weight: 600;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            Icon {
                shape: Icons.edit;
                colour: root.hover ? Theme.accent : Theme.text-dim;
                size: Theme.icon-mark;
            }
        }
    }
}

export component PanelRow inherits VerticalLayout {
    in property <string> name;
    in property <string> value;
    in property <color> value-colour: Theme.text-dim;
    spacing: Theme.space-xs;
    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: root.name;
            color: Theme.text;
            font-size: Theme.small;
        }

        Text {
            text: root.value;
            color: root.value-colour;
            font-size: Theme.small;
            horizontal-alignment: right;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    @children
}

export component Caption inherits Text {
    color: Theme.text-dim;
    font-size: Theme.small;
    wrap: word-wrap;
}

export component Note inherits Text {
    color: Theme.text-faint;
    font-size: Theme.tiny;
    overflow: elide;
}

export component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.body;
    font-weight: 600;
}

export component Title inherits Heading {
    font-size: Theme.title;
}

export component PageTitle inherits Text {
    color: Theme.text;
    font-size: Theme.large;
    font-weight: 700;
    horizontal-alignment: center;
}

export component Lead inherits Text {
    color: Theme.text-dim;
    font-size: Theme.body;
    horizontal-alignment: center;
}

export component Reading inherits Text {
    color: Theme.text-dim;
    font-size: Theme.small;
    vertical-alignment: center;
    horizontal-alignment: right;
    width: 46px;
}

export component HorizontalRule inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component VerticalRule inherits Rectangle {
    width: 1px;
    background: Theme.line;
}

export component SidePanel inherits Rectangle {
    width: Theme.sidebar;
    background: Theme.surface;
}

export component SidebarTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Theme.space-xxs;
    horizontal-stretch: 1;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.side-title;
        font-weight: 700;
        overflow: elide;
    }

    Caption {
        text: root.subtitle;
        wrap: no-wrap;
        overflow: elide;
    }
}

export component SidebarFoot inherits VerticalLayout {
    HorizontalRule { }

    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        @children
    }
}

export component LockMark inherits Icon {
    in property <bool> locked;
    in property <bool> opening;
    shape: root.locked && !root.opening ? Icons.lock : Icons.unlock;
    colour: root.locked ? Theme.bad : Theme.text-dim;
    size: Theme.icon;
    accessible-role: text;
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    in property <length> most-width;
    callback dismissed();
    width: min(root.most-width, said.preferred-width + 2 * Theme.space-l);
    height: said.preferred-height + 2 * Theme.space-s + Theme.space-xxs;
    border-radius: Theme.radius;
    background: root.error ? Theme.bad-fill : Theme.toast;
    drop-shadow-blur: Theme.lift-blur;
    drop-shadow-offset-y: Theme.lift-offset;
    drop-shadow-color: Theme.lift-shadow;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    said := Text {
        x: Theme.space-l;
        width: parent.width - 2 * Theme.space-l;
        text: root.text;
        accessible-role: none;
        color: Theme.on-accent;
        font-size: Theme.body;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }
}

export component Sheet inherits Rectangle {
    in property <string> title;
    in property <length> sheet-width: Theme.sheet-narrow;
    in property <bool> closable: true;
    in property <bool> holds-keys: true;
    out property <length> content-width: card.width - 2 * Theme.space-xl;
    callback closed();
    callback confirmed();
    background: Theme.scrim;
    TouchArea {
        clicked => {
            if root.closable {
                root.closed();
            }
        }
    }

    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape && root.closable {
                root.closed();
                return accept;
            }
            if event.text == Key.Return {
                root.confirmed();
                return accept;
            }
            return reject;
        }
        init => {
            if root.holds-keys {
                self.focus();
            }
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.sheet-width, parent.width - 2 * Theme.space-l);
            height: min(content.preferred-height, parent.height - 2 * Theme.space-l);
            border-radius: Theme.radius-large;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: Theme.sheet-blur;
            drop-shadow-offset-y: Theme.sheet-offset;
            drop-shadow-color: Theme.sheet-shadow;
            clip: true;
            TouchArea { }

            content := VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-l;
                HorizontalLayout {
                    spacing: Theme.space-s;
                    min-height: 30px;
                    Title {
                        text: root.title;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.closable: IconButton {
                        label: "Close";
                        shape: Icons.close;
                        clicked => {
                            root.closed();
                        }
                    }
                }

                @children
            }
        }
    }
}

export component Popover inherits Rectangle {
    in property <string> title;
    in property <length> card-x;
    in property <length> card-y;
    in property <bool> compact;
    out property <length> card-height: card.height;
    callback dismissed();
    callback card-pressed();
    TouchArea {
        clicked => {
            root.dismissed();
        }
    }

    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
        init => {
            self.focus();
        }

        card := Rectangle {
            x: root.card-x;
            y: root.card-y;
            width: Theme.popover;
            height: content.preferred-height;
            border-radius: Theme.radius-large;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.edge;
            drop-shadow-blur: Theme.lift-blur;
            drop-shadow-offset-y: Theme.lift-offset;
            drop-shadow-color: Theme.lift-shadow;
            TouchArea {
                clicked => {
                    root.card-pressed();
                }
            }

            content := VerticalLayout {
                padding: root.compact ? Theme.space-m : Theme.space-l;
                spacing: root.compact ? Theme.space-s : Theme.space-m;
                if root.title != "": Heading {
                    text: root.title;
                }

                @children
            }
        }
    }
}

export component RoomSize inherits HorizontalLayout {
    in property <string> label;
    in property <Seats> seats;
    callback moved(seats: Seats);
    callback released();
    property <int> past-the-most: State.most-seats + 1;
    spacing: Theme.space-s;
    SliderBar {
        label: root.label;
        minimum: State.fewest-seats;
        maximum: root.past-the-most;
        value: root.seats.any ? root.past-the-most : root.seats.most;
        moved(value) => {
            root.moved({ any: value >= root.past-the-most, most: min(Math.round(value), State.most-seats) });
        }
        released => {
            root.released();
        }
    }

    Text {
        width: 72px;
        text: root.seats.any ? "No limit" : root.seats.most + " people";
        color: Theme.text;
        font-size: Theme.body;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
